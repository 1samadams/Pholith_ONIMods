<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped package source.

  This machine's NuGet.Config at %APPDATA%\NuGet\NuGet.Config has an
  intentionally empty <packageSources> block, so without this file a restore
  fails with NU1100 for every package - including the framework reference
  assemblies. NuGet walks up from the project directory, so placing this at the
  repo root covers every mod under src/.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
