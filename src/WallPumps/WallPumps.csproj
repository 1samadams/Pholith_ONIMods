<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style port of the original non-SDK project. Builds with just the dotnet
    SDK - no Visual Studio, no packages.config, no ILRepack.Lib.MSBuild.Task.

    Game DLLs resolve through $(GameLibsDir), set in GamePath.local.props at the
    repo root (gitignored; see GamePath.local.props.example).
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>WallPumps</AssemblyName>
    <RootNamespace>WallPumps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <UsesGameLibs>true</UsesGameLibs>

    <!-- Properties\AssemblyInfo.cs is checked in; don't generate a second set of attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Output goes straight into the committed mod folder, with no net48\ subdirectory. -->
    <OutputPath>..\..\Mods\WallPumps\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Pholib\Utilities.cs" Link="Utilities.cs" />
  </ItemGroup>

  <!-- Files the packaged mod needs at runtime. The texture\ folder holds the
       Spriter sources the kanims were built from and stays out of the output. -->
  <ItemGroup>
    <None Update="anim\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="translations\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="preview.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="mod.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="mod_info.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Game assemblies: referenced, never copied to the output. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameLibsDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameLibsDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameLibsDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLibsDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameLibsDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameLibsDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameLibsDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets=runtime keeps PLib off the output folder; ONIMod.targets
         merges it into the mod assembly straight from the package. Bumped from
         4.24.0 so both mods here build against one PLib. -->
    <PackageReference Include="PLib" Version="4.25.0" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ILRepack" Version="2.0.46" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>

  <Import Project="..\ONIMod.targets" />

</Project>
